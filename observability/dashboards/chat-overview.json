{
  "uid": "chat-overview",
  "title": "Chat \u00b7 Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "chatapp"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "description": "Server-side telemetry. Accepted counts command attempts, including retries. Submitted does not confirm client receipt. Missing series display No telemetry; generate activity and wait for export.",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(process_uptime_seconds, service)",
        "refresh": 1,
        "current": {
          "text": "chatapp",
          "value": "chatapp"
        },
        "includeAll": false
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(process_uptime_seconds{service=~\"$service\"}, instance)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Chat dashboards",
      "type": "dashboards",
      "tags": [
        "chatapp"
      ],
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "title": "Command outcomes / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(chat_messages_accepted_total{service=~\"$service\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "accepted",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(chat_messages_rejected_total{service=~\"$service\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "rejected",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No telemetry",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Rejected command ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(chat_messages_rejected_total{service=~\"$service\",instance=~\"$instance\"}[$__rate_interval])) / (sum(rate(chat_messages_accepted_total{service=~\"$service\",instance=~\"$instance\"}[$__rate_interval])) + sum(rate(chat_messages_rejected_total{service=~\"$service\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{operation}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No telemetry",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Authenticated connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(chat_connections_active{service=~\"$service\",instance=~\"$instance\"})",
          "legendFormat": "{{operation}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Message processing latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chat_operation_seconds_bucket{service=~\"$service\",instance=~\"$instance\",operation=\"send\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chat_operation_seconds_bucket{service=~\"$service\",instance=~\"$instance\",operation=\"send\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(chat_operation_seconds_bucket{service=~\"$service\",instance=~\"$instance\",operation=\"send\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No telemetry",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Dispatch submissions / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(chat_delivery_submitted_total{service=~\"$service\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "submitted (not confirmed receipt)",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No telemetry",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Dispatch and reply failures / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(chat_delivery_failures_total{service=~\"$service\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "dispatch",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(chat_reply_failures_total{service=~\"$service\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "reply",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No telemetry",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "STOMP command latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chat_stomp_seconds_bucket{service=~\"$service\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chat_stomp_seconds_bucket{service=~\"$service\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(chat_stomp_seconds_bucket{service=~\"$service\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No telemetry",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Failure events by stage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(chat_failures_total{service=~\"$service\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{stage}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No telemetry",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    }
  ]
}
